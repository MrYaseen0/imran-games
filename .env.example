# Imran Games — example environment variables
# Copy to .env and fill in real values from the Supabase dashboard.
# NEVER commit a real .env, key, password, or secret to the repo.
# Every value below is an obviously-fake placeholder, not a real value.

# Supabase project URL (from the Supabase dashboard, Project Settings)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable (anon) key — public-safe by design, RLS is the control.
# Paste the real key from the dashboard; never paste it here or in chat.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Supabase service-role key — SERVER/ADMIN USE ONLY.
# NEVER put this in client code, in the repo, or in chat.
# The admin panel must never use it; privileged actions go through
# SECURITY DEFINER functions that verify the session and role.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Vercel project (file-upload deploys only; this project has no git link)
VERCEL_PROJECT=YOUR_VERCEL_PROJECT_NAME_HERE

# hCaptcha site key (public identifier shown on the login widget).
# The hCaptcha SECRET is never stored here — it lives only in the
# hCaptcha dashboard / Supabase Auth settings.
HCAPTCHA_SITEKEY=YOUR_HCAPTCHA_SITEKEY_HERE
